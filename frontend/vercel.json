{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    },
    "api/health.ts": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/health", "dest": "/api/health.ts" },
    { "src": "/api/health", "dest": "/api/health.ts" },
    { "src": "/api/v1/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
