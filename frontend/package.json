  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "description": "Frontend ContaGest-VE Enterprise ERP con migración interna módulo por módulo al UI Kit unificado, RBAC, demos y monitoreo.",
  "scripts": {
