{
  "name": "contagest-ve-frontend",
  "version": "11.14.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "description": "Frontend ContaGest-VE Enterprise con UI MUI compacta, RBAC, licencias, PWA y verticales especializadas.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "stage:backend": "node scripts/stage-backend.mjs",
    "build:identity": "node scripts/write-build-info.mjs && node scripts/write-hipico-build-info.mjs",
    "preqa:source": "cd .. && node scripts/vercel-source-preqa-diagnostic.mjs",
    "preqa:browser": "cd .. && node scripts/vercel-browser-preqa-v16.mjs",
    "build": "node scripts/vercel-build.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 8080"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.4.0",
    "contagest-ve-backend": "file:../backend",
    "html5-qrcode": "2.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "2.6.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "vite": "8.3.0",
    "typescript": "5.9.3",
    "tailwindcss": "3.4.19",
    "postcss": "8.5.28",
    "autoprefixer": "10.6.1"
  }
}
