{
  "name": "contagest-ve-backend",
  "version": "11.3.2",
  "type": "module",
  "private": true,
  "main": "./src/app.ts",
  "exports": {
    ".": "./src/app.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "description": "Backend ContaGest-VE Enterprise ERP con RBAC, Supabase/Prisma, demos, monitoreo y hardening.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "dev:mock": "node mock-server.mjs",
    "db:auto:create": "prisma migrate deploy && prisma db seed && npm run db:rls",
    "db:dev:create": "prisma migrate dev --name init && prisma db seed && npm run db:rls",
    "db:rls": "node scripts/apply-rls.mjs",
    "supabase:link": "supabase link --project-ref YOUR_PROJECT_REF",
    "supabase:db:push": "supabase db push",
    "db:reset:supabase": "prisma migrate reset --force && prisma db seed && npm run db:rls",
    "db:validate": "prisma validate",
    "db:doctor": "node scripts/doctor-db.mjs",
    "db:create:safe": "npm run db:doctor && npx prisma validate && npx prisma generate && npx prisma migrate deploy && npx prisma db seed && npm run db:rls",
    "db:create:gitbash": "bash scripts/create-tables-gitbash.sh",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "seed:admin": "tsx prisma/seed.ts",
    "seed:clean": "tsx prisma/seed.ts --clean-demo"
  },
  "dependencies": {
    "@prisma/client": "6",
    "@supabase/supabase-js": "latest",
    "bcryptjs": "latest",
    "bwip-js": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "exceljs": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "morgan": "latest",
    "pdfkit": "latest",
    "pg": "latest",
    "pino": "latest",
    "prisma": "6",
    "qrcode": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "@types/pdfkit": "latest",
    "@types/pg": "latest",
    "@types/qrcode": "latest",
    "tsx": "latest",
    "typescript": "5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
