NODE_ENV=development
PORT=3030
APP_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
JWT_SECRET=replace_with_a_secure_32_char_secret
API_MODE=prisma
JSON_BODY_LIMIT=1mb

# Observabilidad / SRE (#98)
# Pino emite JSON estructurado. LOG_LEVEL acepta fatal|error|warn|info|debug|trace|silent.
LOG_LEVEL=info
# El runtime detecta automáticamente VERCEL_GIT_COMMIT_SHA/GITHUB_SHA; usa GIT_COMMIT_SHA
# sólo en despliegues que no inyecten un SHA de build de forma nativa.
GIT_COMMIT_SHA=
SERVICE_VERSION=
# Readiness usa un SELECT 1 acotado; cachea el resultado para evitar amplificación de DB.
READINESS_DB_TIMEOUT_MS=1500
READINESS_CACHE_MS=2000
# En producción /metrics es privado. Configura un token aleatorio de 32+ caracteres
# y úsalo únicamente desde el scraper/monitor autorizado. Nunca exponerlo al frontend.
OBSERVABILITY_METRICS_TOKEN=

# Gate legal de producción (#29)
LEGAL_PROVIDER_NAME=
LEGAL_PROVIDER_RIF=
LEGAL_PROVIDER_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_SUPPORT_EMAIL=
LEGAL_REVIEW_APPROVED_VERSION=
LEGAL_REVIEW_EVIDENCE_SHA256=

# Authentication throttle
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_OBSERVATION_WINDOW_SECONDS=900
AUTH_LOGIN_LOCK_SECONDS=900
AUTH_LOGIN_ATTEMPT_RETENTION_DAYS=90

# PostgreSQL / Supabase — separación obligatoria de credenciales
DATABASE_RUNTIME_URL="postgresql://contagest_runtime.[PROJECT_REF]:[RUNTIME_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=10&sslmode=require&application_name=contagest-runtime"
DATABASE_RUNTIME_EXPECTED_ROLE=contagest_runtime
DIRECT_DATABASE_URL="postgresql://postgres:[MIGRATION_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres:[LOCAL_OR_QA_PASSWORD]@127.0.0.1:5432/postgres?schema=public"
DATABASE_BACKUP_URL="postgresql://contagest_backup:[BACKUP_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require&application_name=contagest-backup"
DATABASE_BACKUP_EXPECTED_ROLE=contagest_backup
DATABASE_MONITOR_URL="postgresql://contagest_monitor.[PROJECT_REF]:[MONITOR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&application_name=contagest-security-monitor"
DATABASE_MONITOR_EXPECTED_ROLE=contagest_monitor
DB_MASS_CHANGE_ROW_THRESHOLD=500
DB_SECURITY_AUDIT_WINDOW_MINUTES=70
SECURITY_ALERT_WEBHOOK_URL=

SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key_never_expose_in_frontend

# External providers / optional integrations
BCV_PROVIDER=https://pydolarve.org/api/v1/dollar?page=bcv
BCV_CACHE_TTL_MS=3600000
MOCK_BCV_RATE=36.25
SENIAT_BASE_URL=https://contribuyente.seniat.gob.ve
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=

# Control Hípico — independent product sharing backend/database infrastructure
# Keep all secrets server-side. The normal WhatsApp group laboratory uses the
# separate HIPICO_GROUP_BRIDGE_TOKEN. Group ingestion remains shadow-only until
# its conformance gate is explicitly promoted.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
HIPICO_BOT_OPERATOR_TOKEN=
HIPICO_GROUP_BRIDGE_TOKEN=
HIPICO_BOT_PROMOTION=shadow

# Canonical document tenancy. These UUIDs are deployment configuration, not client input.
HIPICO_OWNER_ID=
HIPICO_BRIDGE_OWNER_ID=

# WhatsApp Web Bridge identity is validated independently on backend and linked device.
HIPICO_SOURCE_GROUP_ID=
HIPICO_LAB_GROUP_ID=
HIPICO_SOURCE_CHANNEL_KEY=club-hipico-triple-crown-official
HIPICO_OFFICIAL_SOURCE_CHANNEL_KEY=club-hipico-triple-crown-official
HIPICO_LAB_CHANNEL_KEY=control-hipico-lab

# AnyDoc 0.2.4 is installed locally with: npm run hipico:anydoc:install
# Leave HIPICO_ANYDOC_BIN empty to auto-discover .tools/hipico-anydoc.
HIPICO_ANYDOC_BIN=
# Privacy default: false. When false, scanned PDFs use local Poppler/Tesseract fallback.
HIPICO_DOCUMENT_ANYDOC_HOSTED_OCR_ENABLED=false
# Only required when hosted OCR is deliberately enabled. Never expose to frontend/Bridge.
FIRECRAWL_API_KEY=
