NODE_ENV=development
PORT=3030
APP_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
JWT_SECRET=replace_with_a_secure_32_char_secret
API_MODE=prisma
JSON_BODY_LIMIT=1mb

# Observabilidad / SRE (#98)
# Pino emite JSON estructurado. LOG_LEVEL acepta fatal|error|warn|info|debug|trace|silent.
LOG_LEVEL=info
# El runtime detecta automáticamente VERCEL_GIT_COMMIT_SHA/GITHUB_SHA; usa GIT_COMMIT_SHA
# sólo en despliegues que no inyecten un SHA de build de forma nativa.
GIT_COMMIT_SHA=
SERVICE_VERSION=
# Readiness usa un SELECT 1 acotado; cachea el resultado para evitar amplificación de DB.
READINESS_DB_TIMEOUT_MS=1500
READINESS_CACHE_MS=2000
# En producción /metrics es privado. Configura un token aleatorio de 32+ caracteres
# y úsalo únicamente desde el scraper/monitor autorizado. Nunca exponerlo al frontend.
OBSERVABILITY_METRICS_TOKEN=

# Gate legal de producción (#29)
# Dejar vacíos en desarrollo. En producción deben contener la identidad contractual real
# revisada profesionalmente; placeholders o example.com mantienen el gate bloqueado.
LEGAL_PROVIDER_NAME=
LEGAL_PROVIDER_RIF=
LEGAL_PROVIDER_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_SUPPORT_EMAIL=
# Deben coincidir con la atestación profesional aprobada para este release.
# No son secretos: vinculan el runtime a la versión contractual y al hash de la evidencia.
LEGAL_REVIEW_APPROVED_VERSION=
LEGAL_REVIEW_EVIDENCE_SHA256=

# Authentication throttle — account identity (normalized RIF + email), never IP-only.
# These are product/deployment defaults, not OWASP-mandated constants.
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_OBSERVATION_WINDOW_SECONDS=900
AUTH_LOGIN_LOCK_SECONDS=900
AUTH_LOGIN_ATTEMPT_RETENTION_DAYS=90

# PostgreSQL / Supabase — separación obligatoria de credenciales
# PRODUCCIÓN/SERVERLESS: rol DML dedicado, sin owner/superuser, usando pooler transaction mode.
DATABASE_RUNTIME_URL="postgresql://contagest_runtime.[PROJECT_REF]:[RUNTIME_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=10&sslmode=require&application_name=contagest-runtime"
DATABASE_RUNTIME_EXPECTED_ROLE=contagest_runtime

# MIGRACIONES/DDL: conexión directa y credencial distinta. Nunca usarla en el runtime de Vercel.
DIRECT_DATABASE_URL="postgresql://postgres:[MIGRATION_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# Compatibilidad local/CI. En producción el backend NO permite usar DATABASE_URL como fallback.
DATABASE_URL="postgresql://postgres:[LOCAL_OR_QA_PASSWORD]@127.0.0.1:5432/postgres?schema=public"

# BACKUP: rol read-only distinto; conexión directa o session pooler 5432 para pg_dump.
DATABASE_BACKUP_URL="postgresql://contagest_backup:[BACKUP_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require&application_name=contagest-backup"
DATABASE_BACKUP_EXPECTED_ROLE=contagest_backup

# MONITOREO: rol mínimo; lee estadísticas/AuditLog y solo actualiza su snapshot privado.
DATABASE_MONITOR_URL="postgresql://contagest_monitor.[PROJECT_REF]:[MONITOR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&application_name=contagest-security-monitor"
DATABASE_MONITOR_EXPECTED_ROLE=contagest_monitor
DB_MASS_CHANGE_ROW_THRESHOLD=500
DB_SECURITY_AUDIT_WINDOW_MINUTES=70
SECURITY_ALERT_WEBHOOK_URL=

SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key_never_expose_in_frontend

# External providers / optional integrations
BCV_PROVIDER=https://pydolarve.org/api/v1/dollar?page=bcv
BCV_CACHE_TTL_MS=3600000
MOCK_BCV_RATE=36.25
SENIAT_BASE_URL=https://contribuyente.seniat.gob.ve
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=

# -----------------------------------------------------------------------------
# Control Hípico — producto independiente que comparte temporalmente backend/DB
# -----------------------------------------------------------------------------
# Todos los secretos quedan sólo en servidor/secret store. Este archivo define nombres,
# defaults fail-closed y límites de configuración; nunca contiene credenciales, IDs reales
# de grupos, destinos reales, identidad del propietario ni SHA aprobados.

# Identidad del dominio canónico. HIPICO_OWNER_ID debe ser el UUID real del owner/tenant
# únicamente en el entorno autorizado; vacío mantiene las escrituras canónicas bloqueadas.
HIPICO_OWNER_ID=

# Persistencia de las funciones serverless Hípico. Se mantiene separada de SUPABASE_* para
# no reutilizar por accidente credenciales generales del ERP en adapters externos.
HIPICO_SUPABASE_URL=
HIPICO_SUPABASE_SERVICE_ROLE_KEY=
# Token interno para invocar operaciones serverless de control/sender; 32+ bytes aleatorios.
HIPICO_INTERNAL_API_TOKEN=

# Control operador. HIPICO_OPERATOR_CONTROL_TOKEN es el nombre canónico y debe ser un
# secreto fuerte. HIPICO_BOT_OPERATOR_TOKEN queda sólo como alias de compatibilidad.
HIPICO_OPERATOR_CONTROL_TOKEN=
# compat: alias legado HIPICO_BOT_OPERATOR_TOKEN; dejar vacío cuando exista el canónico.
HIPICO_BOT_OPERATOR_TOKEN=

# Modo del bot. `shadow` es el default seguro: no promueve respuestas a envío automático.
HIPICO_BOT_PROMOTION=shadow

# Jev / TypeSafe decision sidecar. OFF por defecto: no realiza llamadas externas.
# Para evaluar en SHADOW deben cumplirse simultáneamente modo, secreto y aprobación
# explícita de compartir el texto operacional con el proveedor. Jev nunca autoriza
# dinero, tools, cambios de estado ni envíos; sólo produce evidencia para comparación.
HIPICO_JEV_MODE=off
HIPICO_JEV_MODEL=jev-latest
HIPICO_JEV_TIMEOUT_MS=1200
HIPICO_JEV_DATA_SHARING_APPROVED=false
TYPESAFE_API_KEY=

# Meta webhook/transporte individual. Los mismos nombres canónicos alimentan backend y
# serverless para evitar dos configuraciones divergentes del mismo canal Cloud.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
# compat: WHATSAPP_GRAPH_VERSION se conserva mientras existan despliegues antiguos.
WHATSAPP_GRAPH_VERSION=v23.0
# compat serverless: HIPICO_META_ACCESS_TOKEN, HIPICO_META_PHONE_NUMBER_ID,
# HIPICO_META_GRAPH_VERSION, HIPICO_META_VERIFY_TOKEN y HIPICO_META_APP_SECRET son sólo
# aliases legado de fallback; no configurarlos en instalaciones nuevas.

# WhatsApp normal / WhatsApp Web Bridge — SOURCE permite respuestas conversacionales
# autónomas sólo cuando este switch está activo. El switch NO concede autoridad sobre
# dinero, jugadas, resultados, carrera ni ledger; esas fronteras permanecen fail-closed.
# Los @g.us reales se capturan fuera de Git con el helper de binding y deben ser distintos.
HIPICO_GROUP_BRIDGE_TOKEN=
HIPICO_SOURCE_AUTO_REPLY_ENABLED=false
HIPICO_SOURCE_GROUP_ID=
HIPICO_LAB_GROUP_ID=
HIPICO_OFFICIAL_SOURCE_CHANNEL_KEY=club-hipico-triple-crown-official
# compat: HIPICO_SOURCE_CHANNEL_KEY es alias de HIPICO_OFFICIAL_SOURCE_CHANNEL_KEY.
HIPICO_SOURCE_CHANNEL_KEY=club-hipico-triple-crown-official
HIPICO_LAB_CHANNEL_KEY=control-hipico-lab

# WhatsApp Cloud outbound — opcional, sólo individual y fail-closed.
# No habilita envío al grupo SOURCE. Todas las condiciones deben cumplirse a la vez.
HIPICO_CLOUD_SEND_ENABLED=false
HIPICO_WHATSAPP_COMPLIANCE_DECISION=
HIPICO_CLOUD_SEND_APPROVED_BY=
HIPICO_CLOUD_SEND_CANDIDATE_SHA=
HIPICO_CLOUD_ALLOWED_DESTINATIONS=
HIPICO_CLOUD_SEND_TIMEOUT_MS=12000

# Worker de public.hipico_outbox. Deshabilitado por defecto y subordinado a TODOS los
# gates anteriores (GO/compliance, aprobación, SHA exacto, allowlist y transporte válido).
# Nunca reclama filas con payload.approvalRequired=true; sólo /approve/:id puede hacerlo.
HIPICO_OUTBOX_WORKER_ENABLED=false
HIPICO_OUTBOX_WORKER_INTERVAL_MS=5000
HIPICO_OUTBOX_WORKER_MAX_PER_CYCLE=10

# Proveedor hípico externo — enrichment opcional, nunca autoridad financiera.
# `disabled` es el default; sin configuración no bloquea la operación manual/shadow.
HIPICO_RACE_PROVIDER=disabled
HIPICO_RACE_PROVIDER_BASE_URL=
HIPICO_SPORTRADAR_UOF_TOKEN=
HIPICO_RACE_PROVIDER_LANGUAGE=en
HIPICO_RACE_PROVIDER_TIMEOUT_MS=5000
HIPICO_RACE_PROVIDER_CACHE_TTL_MS=30000
HIPICO_RACE_PROVIDER_STALE_TTL_MS=120000
HIPICO_RACE_PROVIDER_FAILURE_THRESHOLD=3
HIPICO_RACE_PROVIDER_BACKOFF_MS=15000