    "audit:erp-ui-sales": "node scripts/erp-ui-sales-audit-v551.mjs",
    "audit:erp-ui-purchases": "node scripts/erp-ui-purchases-audit-v651.mjs",
    "audit:erp-ui-banking": "node scripts/erp-ui-banking-audit-v751.mjs",
