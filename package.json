{
  "name": "contagest-coloso",
  "version": "11.14.0",
  "private": true,
  "type": "module",
  "engines": {"node": "22.x"},
  "workspaces": ["frontend","backend"],
  "scripts": {
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "build:frontend": "npm --workspace frontend run build",
    "build:backend": "npm --workspace backend run build",
    "build": "npm run build:frontend && npm run build:backend",
    "typecheck": "npm --workspace backend run typecheck",
    "lint": "npm run typecheck && node --test tests/*.test.mjs",
    "test:hipico": "npm --workspace backend run test:hipico && node --test tests/hipico_real_operativa_shadow_contract.test.mjs tests/hipico_v13_security_contract.test.mjs",
    "test:visual": "node --test tests/visual_system_v12_contract.test.mjs tests/visual_module_catalog_contract.test.mjs tests/visual_module_adapter_contract.test.mjs tests/visual_consolidation_v13_contract.test.mjs tests/erp_ux_v14_contract.test.mjs",
    "test:visual:v15": "node --test tests/visual_system_v12_contract.test.mjs tests/visual_module_adapter_contract.test.mjs tests/erp_ux_v14_contract.test.mjs",
    "test:visual:v14": "npm run test:visual:v15",
    "test:financial:decimal": "npm --workspace backend exec -- tsx --test ../qa/financial-decimal-v90.test.ts",
    "test:ledger:unit": "npm --workspace backend exec -- tsx --test ../qa/ledger-posting-v91.test.ts",
    "test:backend:ledger:real": "npm --workspace backend exec -- tsx --test ../qa/ledger-posting-real-v91.test.ts ../qa/ledger-posting-authz-v91.test.ts",
    "test": "npm --workspace backend run test && node --test tests/*.test.mjs && npm run test:financial:decimal && npm run test:ledger:unit",
    "test:browser": "playwright test",
    "test:browser:visual": "playwright test qa/erp-style-system.spec.mjs qa/responsive-all-routes.spec.mjs qa/visual-system-v12.spec.mjs",
    "test:browser:visual:deep": "playwright test qa/module-visual-deep-v12.spec.mjs",
    "test:browser:contrast": "playwright test qa/contrast-v15.spec.mjs",
    "test:browser:functional": "playwright test qa/erp-functional-smoke-v14.spec.mjs",
    "test:browser:fine-composition": "playwright test qa/fine-composition-v166.spec.mjs --workers=1",
    "test:browser:58": "playwright test qa/exhaustive-route-v164.spec.mjs qa/fine-composition-v166.spec.mjs qa/route-transition-v164.spec.mjs --workers=1",
    "test:browser:a11y": "playwright test qa/accessibility-wcag22-v99.spec.mjs --project=chromium --workers=1",
    "test:backend:persistence:real": "npm --workspace backend exec -- tsx --test ../qa/postmerge-backend-persistence-v17.test.ts",
    "test:backend:financial:real": "npm --workspace backend exec -- tsx --test ../qa/postmerge-financial-domain-v17.test.ts",
    "test:backend:financial:decimal:real": "npm --workspace backend exec -- tsx --test ../qa/financial-decimal-real-v90.test.ts",
    "test:backend:idempotency:real": "npm --workspace backend exec -- tsx --test ../qa/financial-idempotency-v92.test.ts",
    "test:backend:commercial:real": "npm --workspace backend exec -- tsx --test ../qa/commercial-backend-real-v23.test.ts ../qa/financial-idempotency-v92.test.ts",
    "test:qa:58x5": "npm run test:backend:persistence:real && npm run test:backend:financial:real && npm run doctor:changed && npm run doctor:design && npm run test:browser:58",
    "audit:visual": "node scripts/visual-system-audit.mjs",
    "audit:visual:strict": "node scripts/visual-system-audit.mjs --strict",
    "audit:functions": "node scripts/erp-module-function-audit.mjs",
    "audit:functions:strict": "node scripts/erp-module-function-audit.mjs --strict",
    "agent:gates": "node scripts/agent-gate-router.mjs",
    "doctor:changed": "npx --yes react-doctor@latest --verbose --scope changed",
    "doctor:full": "npx --yes react-doctor@latest --verbose",
    "doctor:design": "npx --yes react-doctor@latest design --verbose",
    "doctor:install-skill": "npx --yes react-doctor@latest install",
    "qa:ui": "npm run audit:visual:strict && npm run audit:functions:strict && npm run test:visual && npm run test:browser:visual && npm run test:browser:contrast",
    "qa:ui:deep": "npm run audit:visual:strict && npm run audit:functions:strict && npm run test:visual && npm run test:browser:visual && npm run test:browser:visual:deep && npm run test:browser:contrast && npm run test:browser:functional",
    "qa:ui:58": "npm run audit:visual:strict && npm run audit:functions:strict && npm run doctor:changed && npm run doctor:design && npm run test:browser:58",
    "qa:a11y": "npm run test:browser:a11y && npm run test:browser:contrast",
    "ci": "npm run lint && npm run test && npm run build && npm run check:bundle",
    "qa:legal:evidence": "node scripts/legal-review-evidence-v29.mjs",
    "qa:legal:production": "node scripts/legal-production-gate.mjs",
    "qa:production": "npm run qa:legal:production && node scripts/production-readiness.mjs",
    "qa:production:full": "npm run qa:legal:production && node scripts/production-readiness.mjs --full",
    "vercel-build": "npm run build:frontend",
    "seed": "npm --workspace backend run seed",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "skills:sync": "node scripts/sync-agent-skills.mjs",
    "skills:check": "node scripts/verify-agent-skills.mjs"
  },
  "devDependencies": {"@playwright/test": "1.62.1"},
  "overrides": {"deepmerge-ts": "8.0.1","uuid": "11.1.1"}
}
