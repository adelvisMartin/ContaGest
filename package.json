    "test:backend:financial:real": "npm --workspace backend exec -- tsx --test ../qa/postmerge-financial-domain-v17.test.ts",
    "audit:erp-ui-ledger": "node scripts/erp-ui-ledger-audit-v851.mjs",
    "audit:erp-ui-taxes": "node scripts/erp-ui-taxes-audit-v951.mjs",
    "test:browser:58:core": "node scripts/erp-browser-58x5-v251.mjs core",
    "test:browser:58:shard": "node scripts/erp-browser-58x5-v251.mjs shard",
    "test:browser:58": "node scripts/erp-browser-58x5-v251.mjs full",
    "test:backend:verticals:real": "npm --workspace backend exec -- tsx --test ../qa/verticals-backend-real-v4851.test.ts",
    "test:browser:verticals:visual": "npx playwright test qa/erp-visual-overlap-v4951.spec.mjs --project=chromium --workers=1",
    "test:backend:provisioning:real": "npm --workspace backend exec -- tsx --test ../qa/tenant-user-provisioning-v5575.test.ts",
    "test:browser:verticals:real": "node scripts/erp-real-browser-postgres-v5875.mjs",
    "test:contracts:current": "node scripts/run-authoritative-contracts.mjs",
    "test:browser:a11y": "npx playwright test qa/accessibility-wcag22-v99.spec.mjs --project=chromium --workers=1",
    "test:browser:contrast": "npx playwright test qa/contrast-v15.spec.mjs --project=chromium --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
