[Unit]
Description=Control Hipico WhatsApp Web Bridge
Documentation=https://github.com/adelvisMartin/ContaGest
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=controlhipico
Group=controlhipico
WorkingDirectory=/opt/control-hipico-bridge/current/tools/hipico-whatsapp-web-bridge
EnvironmentFile=/etc/control-hipico-bridge/bridge.env
Environment=NODE_ENV=production
Environment=HOME=/var/lib/control-hipico-bridge
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1366x768x24 -nolisten tcp" /usr/bin/node src/server-runner.mjs
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=42
TimeoutStopSec=25s
KillMode=mixed
UMask=0077

StateDirectory=control-hipico-bridge
StateDirectoryMode=0700
RuntimeDirectory=control-hipico-bridge
RuntimeDirectoryMode=0700
ReadWritePaths=/var/lib/control-hipico-bridge

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=1G
CPUQuota=150%
TasksMax=512
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=control-hipico-bridge

[Install]
WantedBy=multi-user.target
