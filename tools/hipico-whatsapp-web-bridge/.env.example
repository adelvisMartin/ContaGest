HIPICO_RUNTIME_MODE=production
HIPICO_BACKEND_SYNC_ENABLED=true
HIPICO_INGEST_URL=https://conta-gest-frontend.vercel.app/api/v1/hipico-bot/bridge/events
HIPICO_BRIDGE_HEALTH_URL=https://conta-gest-frontend.vercel.app/api/v1/hipico-bot/bridge/health
# Optional override. By default it is derived from HIPICO_INGEST_URL as /bridge/documents.
HIPICO_DOCUMENT_INGEST_URL=https://conta-gest-frontend.vercel.app/api/v1/hipico-bot/bridge/documents
HIPICO_GROUP_BRIDGE_TOKEN=
HIPICO_DATA_DIR=

# Automatic PDF ingestion is enabled by default only in production with backend sync.
# It downloads only new live PDFs after the startup baseline; history replay is forbidden.
HIPICO_PDF_AUTO_INGEST_ENABLED=true
HIPICO_PDF_SPOOL_MAX_DOCUMENTS=50
HIPICO_DOCUMENT_BACKEND_TIMEOUT_MS=15000

# WhatsApp source: title aliases are discovery hints only. Production automation
# also requires the stable @g.us IDs captured from the linked WhatsApp session.
HIPICO_SOURCE_GROUP_MATCHES=CLUB HIPICO TRIPLE COWN|CLUB HIPICO TRIPLE CROWN
HIPICO_SOURCE_GROUP_MATCH=CLUB HIPICO TRIPLE CROWN
HIPICO_SOURCE_GROUP_ID=
HIPICO_SOURCE_CHANNEL_KEY=club-hipico-triple-crown-official
HIPICO_LAB_GROUP_NAME=Control hípico lab
HIPICO_LAB_GROUP_ID=
HIPICO_LAB_CHANNEL_KEY=control-hipico-lab
HIPICO_REQUIRE_PINNED_GROUP_IDS=true

# Fail-safe defaults. Enable only for an explicit QA window after both @g.us IDs
# have been verified. The source group never becomes a send target.
HIPICO_LAB_SEND_ENABLED=false
HIPICO_LAB_TEST_INPUT_ENABLED=false

HIPICO_POLL_MS=1000
HIPICO_BACKEND_TIMEOUT_MS=15000
HIPICO_BACKEND_MAX_RPS=4
HIPICO_BACKEND_MAX_PER_FLUSH=20
HIPICO_BACKEND_BASE_BACKOFF_MS=5000
HIPICO_BACKEND_MAX_BACKOFF_MS=900000
HIPICO_TRAINING_JOURNAL_ENABLED=true
HIPICO_DIAGNOSTIC_SCREENSHOTS_ENABLED=false
# Must stay true while HIPICO_PDF_AUTO_INGEST_ENABLED=true to avoid automatic historical downloads.
HIPICO_SOURCE_BASELINE_IGNORE_HISTORY=true
HIPICO_LAB_TEST_POLL_MS=5000
HIPICO_LAB_TEST_BOOTSTRAP_LIMIT=8
HIPICO_REPORT_INCLUDE_SAMPLES=false

# Historical backfill is always an explicit separate operation and never auto-downloads PDFs.
HIPICO_HISTORY_SYNC_ON_START=false
HIPICO_HISTORY_MAX_MESSAGES=50000
HIPICO_HISTORY_MAX_MINUTES=90
HIPICO_HISTORY_IDLE_ROUNDS=8
HIPICO_HISTORY_PAGE_WAIT_MS=1200
HIPICO_HISTORY_UPLOAD_CONCURRENCY=4
