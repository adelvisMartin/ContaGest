# Endpoint público ya desplegado por Control Hípico.
HIPICO_INGEST_URL=https://conta-gest-frontend.vercel.app/api/v1/hipico-bot/bridge/events

# Debe coincidir con HIPICO_GROUP_BRIDGE_TOKEN configurado SOLO en Vercel.
# Genera un secreto largo y aleatorio; no lo subas a Git ni lo pegues en tickets.
HIPICO_GROUP_BRIDGE_TOKEN=CAMBIA_ESTE_SECRETO_LARGO

# Primera prueba: el único grupo de laboratorio creado para Control Hípico.
# El backend fuerza modo sombra aunque esta variable sea false: en esta fase
# escucha, deduplica y clasifica, pero NO responde al grupo ni altera saldos.
HIPICO_SHADOW_MODE=false
HIPICO_GROUP_NAME=Control hípico lab

# Kill switch local independiente. DEBE permanecer false en la primera fase.
HIPICO_ALLOW_SEND=false

# Después, para comparar un grupo real contra el laboratorio SIN responder en el real:
# HIPICO_SHADOW_MODE=true
# HIPICO_SOURCE_GROUP_NAME=CLUB HIPICO TRIPLE COWN
# HIPICO_LAB_GROUP_NAME=Control hípico lab
# Opcional: fija IDs exactos después del primer descubrimiento.
# HIPICO_SOURCE_GROUP_ID=120363000000000000@g.us
# HIPICO_LAB_GROUP_ID=120363111111111111@g.us

# Para la prueba inicial queremos capturar también mensajes escritos desde la
# propia cuenta vinculada al Bridge.
HIPICO_INCLUDE_OWN_MESSAGES=true

# Mantén el sandbox de Chromium habilitado. Solo usa true en un host Linux
# aislado que realmente lo requiera y entiendas el impacto de seguridad.
HIPICO_PUPPETEER_NO_SANDBOX=false
