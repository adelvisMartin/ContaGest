# Endpoint HTTPS desplegado por Control Hípico.
# No agregues credenciales, query strings ni fragments a esta URL.
HIPICO_INGEST_URL=https://conta-gest-frontend.vercel.app/api/v1/hipico-bot/bridge/events

# Debe coincidir con HIPICO_GROUP_BRIDGE_TOKEN configurado SOLO en el backend.
# Sustituye este placeholder por un secreto aleatorio de 32+ caracteres y no lo subas a Git.
HIPICO_GROUP_BRIDGE_TOKEN=REEMPLAZA_CON_SECRETO_ALEATORIO_32_CHARS_MINIMO

# Este fallback es SIEMPRE shadow-only. false hace que el proceso falle al arrancar.
HIPICO_SHADOW_MODE=true

# SOURCE y LAB deben fijarse por ID exacto y ser distintos.
# WhatsApp puede usar IDs modernos sin guion o formatos legacy con guion.
HIPICO_SOURCE_GROUP_ID=120363000000000000@g.us
HIPICO_LAB_GROUP_ID=120363111111111111@g.us

# Nombres sólo descriptivos; nunca se usan para decidir la identidad del grupo.
HIPICO_SOURCE_GROUP_NAME=CLUB HIPICO TRIPLE COWN
HIPICO_LAB_GROUP_NAME=Control hípico lab

# Identidades canónicas que deben coincidir con el backend/serverless.
HIPICO_SOURCE_CHANNEL_KEY=club-hipico-triple-crown-official
HIPICO_LAB_CHANNEL_KEY=control-hipico-lab

# Kill switch local independiente. Déjalo false durante shadow/piloto.
# Aun en true, este fallback sólo puede escribir en LAB: no existe ruta de envío a SOURCE.
HIPICO_ALLOW_SEND=false

# Captura también mensajes escritos desde la cuenta vinculada cuando sea necesario para QA.
HIPICO_INCLUDE_OWN_MESSAGES=true

# Mantén el sandbox de Chromium habilitado. Solo usa true en un host Linux
# aislado que realmente lo requiera y entiendas el impacto de seguridad.
HIPICO_PUPPETEER_NO_SANDBOX=false
