# URL pública del endpoint desplegado en Vercel.
HIPICO_INGEST_URL=https://TU-DOMINIO.vercel.app/api/hipico/group-bridge-ingest

# Mismo secreto configurado SOLO en Vercel como HIPICO_GROUP_BRIDGE_TOKEN.
HIPICO_GROUP_BRIDGE_TOKEN=CAMBIA_ESTE_SECRETO_LARGO

# Nombre exacto del grupo de WhatsApp que se escuchará.
HIPICO_GROUP_NAME=Hipico Control Lab

# Opcional: después de descubrir el ID puede fijarse y omitir el nombre.
# HIPICO_GROUP_ID=120363000000000000@g.us

# Para la prueba inicial queremos ver también los mensajes escritos por la cuenta vinculada.
HIPICO_INCLUDE_OWN_MESSAGES=true
