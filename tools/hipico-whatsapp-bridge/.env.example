# URL pública del endpoint desplegado en Vercel.
HIPICO_INGEST_URL=https://TU-DOMINIO.vercel.app/api/hipico/group-bridge-ingest

# Mismo secreto configurado SOLO en Vercel como HIPICO_GROUP_BRIDGE_TOKEN.
HIPICO_GROUP_BRIDGE_TOKEN=CAMBIA_ESTE_SECRETO_LARGO

# Primera prueba: un solo grupo de laboratorio.
# Mantén SHADOW_MODE=false y usa el nombre exacto del grupo.
HIPICO_SHADOW_MODE=false
HIPICO_GROUP_NAME=Control hípico lab

# Después, para comparar un grupo real contra el laboratorio SIN responder en el real:
# HIPICO_SHADOW_MODE=true
# HIPICO_SOURCE_GROUP_NAME=CLUB HIPICO TRIPLE COWN
# HIPICO_LAB_GROUP_NAME=Control hípico lab
# Opcional: fija IDs exactos después del primer descubrimiento.
# HIPICO_SOURCE_GROUP_ID=120363000000000000@g.us
# HIPICO_LAB_GROUP_ID=120363111111111111@g.us

# Para la prueba inicial queremos ver también mensajes escritos por la cuenta vinculada.
HIPICO_INCLUDE_OWN_MESSAGES=true
