{
  "version": 2,
  "product": "control-hipico",
  "releaseMinimumHours": 24,
  "recommendedHours": 48,
  "preferredRcHours": 72,
  "sampleSeconds": 30,
  "minimumHealthCoverageRatio": 0.9,
  "minimumSpoolCoverageRatio": 0.9,
  "thresholds": {
    "maxRssGrowthMbPerHour": 32,
    "maxHeapGrowthMbPerHour": 24,
    "maxEventLoopP95Ms": 250,
    "maxBacklogAgeSeconds": 120,
    "maxSpoolBytes": 536870912,
    "maxUnexpectedDuplicateResponses": 0,
    "maxLostDecisions": 0,
    "maxContextLeaks": 0,
    "maxHealthFailureRate": 0.01
  },
  "requiredDrills": [
    "bridge-restart",
    "backend-restart",
    "lab-reconnect",
    "source-session-reconnect-readonly"
  ],
  "allowedDrillStatuses": ["PASS", "FAIL", "BLOCKED", "NOT_EXECUTED"],
  "drillEvidenceRequired": true,
  "healthEndpointRequiredForRelease": true,
  "spoolPathRequiredForRelease": true,
  "sourceInvariant": "SOURCE remains read-only for the entire run; all generated replay/response traffic is LAB/local only.",
  "releaseRule": "Duration >=24h, health coverage >=90%, valid spool-v2 structure observed >=90%, all required drills PASS with evidence, no threshold violation and exact candidate SHA are required for release PASS. Short runs are SMOKE_ONLY."
}
