# No copiar valores reales al repositorio.
# Estas variables pertenecen al runner de backup/restore, no al frontend ni al runtime de Vercel.

DATABASE_BACKUP_URL="postgresql://contagest_backup:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
DATABASE_BACKUP_EXPECTED_ROLE=contagest_backup

# Clave pública age. La identidad privada debe mantenerse separada y con copia offline.
BACKUP_AGE_RECIPIENT=age1replace_with_public_recipient
# En GitHub Actions la identidad privada se guarda base64 como BACKUP_AGE_IDENTITY_B64.
BACKUP_AGE_IDENTITY_B64=

# Configuración rclone cifrada/secret. RCLONE_REMOTE debe apuntar a proveedor/cuenta externa.
# Ejemplos de nombre lógico: offsite:contagest-prod o b2:contagest-prod.
RCLONE_CONFIG_B64=
RCLONE_REMOTE=offsite:contagest-prod/postgres

BACKUP_SCOPE=contagest-shared
LOCAL_RETENTION_DAYS=7
