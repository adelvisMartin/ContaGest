# Copy to .env on the VPS and chmod 600 .env. Never commit real values.
APP_DOMAIN=erp.example.com
POSTGRES_DB=contagest
POSTGRES_USER=contagest_owner
# Use long URL-safe values because they are interpolated into DATABASE_URL.
POSTGRES_PASSWORD=replace_with_40plus_random_urlsafe_chars
CONTAGEST_APP_PASSWORD=replace_with_different_40plus_random_urlsafe_chars
JWT_SECRET=replace_with_different_48plus_random_urlsafe_chars
LICENSE_HASH_SECRET=replace_with_different_48plus_random_urlsafe_chars
