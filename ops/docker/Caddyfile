{$APP_DOMAIN:localhost} {
  encode zstd gzip
  @api path /api/* /health
  handle @api {
    reverse_proxy api:3030
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }
  log {
    output stdout
    format json
  }
}
