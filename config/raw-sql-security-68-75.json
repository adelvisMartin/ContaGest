{
  "version": 2,
  "scope": {
    "roots": ["backend/src"],
    "extensions": [".ts", ".js", ".mjs"],
    "excludePatterns": ["\\.test\\.", "\\.spec\\.", "\\.d\\.ts$"]
  },
  "methods": ["queryRawUnsafe", "executeRawUnsafe"],
  "rules": {
    "forbidTemplateInterpolation": true,
    "forbidStringConcatenation": true,
    "forbidRequestDerivedSqlArgument": true,
    "forbidDynamicPrismaRaw": true,
    "forbidInlineIgnoreDirectives": true
  },
  "requestDerivedTokens": [
    "req.", "request.", "body.", "params.", "query.", "headers.", "searchParams."
  ],
  "approvedDynamicSql": [],
  "approvedTemplateFragments": [
    {
      "file": "backend/src/modules/commercial/service-restrictions.routes.ts",
      "expression": "CASE_FIELDS",
      "reason": "Source-controlled static column projection; all runtime values remain bound parameters."
    },
    {
      "file": "backend/src/modules/verticals/health-dental-financial.routes.ts",
      "expression": "dentalFinancialLinkSelect",
      "reason": "Imported source-controlled static SELECT/JOIN projection; request and tenant values remain bound parameters."
    },
    {
      "file": "backend/src/modules/verticals/veterinary-financial.routes.ts",
      "expression": "financialCaseSelect",
      "reason": "Source-controlled static SELECT/JOIN projection; request and tenant values remain bound parameters."
    }
  ]
}
